    {
      "name": "1. Flujo obligatorio (E2E)",
      "description": "Consultar menu -> seleccionar -> registrar pedido -> calcular total -> actualizar estado -> consultar",
      "item": [
        {
          "name": "1.1 Consultar menu (Cliente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const menu = pm.response.json();",
                  "pm.test(\"El menu tiene productos con nombre, precio y disponibilidad (RN1)\", () => {",
                  "  pm.expect(menu.length).to.be.at.least(5);",
                  "  menu.forEach(p => {",
                  "    pm.expect(p).to.have.all.keys(\"id\", \"nombre\", \"precio\", \"disponible\");",
                  "    pm.expect(p.precio).to.be.above(0);",
                  "  });",
                  "});",
                  "const disponibles = menu.filter(p => p.disponible);",
                  "const noDisp = menu.find(p => !p.disponible);",
                  "pm.collectionVariables.set(\"productoA\", disponibles[0].id);",
                  "pm.collectionVariables.set(\"precioA\", disponibles[0].precio);",
                  "pm.collectionVariables.set(\"productoB\", disponibles[1].id);",
                  "pm.collectionVariables.set(\"precioB\", disponibles[1].precio);",
                  "if (noDisp) pm.collectionVariables.set(\"productoNoDisponible\", noDisp.id);",
                  "pm.test(\"Tiempo de respuesta < 2 s (RNF5)\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Registrar pedido y calcular total (Cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productoId\": {{productoA}}, \"cantidad\": 2 },\n    { \"productoId\": {{productoB}}, \"cantidad\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set(\"pedidoId\", p.id);",
                  "pm.test(\"Nace en estado RECIBIDO\", () => pm.expect(p.estado).to.eql(\"RECIBIDO\"));",
                  "pm.test(\"Tiene 2 detalles (RN2)\", () => pm.expect(p.detalles.length).to.eql(2));",
                  "const esperado = 2 * Number(pm.collectionVariables.get(\"precioA\")) + 1 * Number(pm.collectionVariables.get(\"precioB\"));",
                  "pm.test(\"Total = suma de precio x cantidad (RN5): \" + esperado, () => {",
                  "  pm.expect(Number(p.total)).to.eql(esperado);",
                  "  const suma = p.detalles.reduce((s, d) => s + Number(d.subtotal), 0);",
                  "  pm.expect(Number(p.total)).to.eql(suma);",
                  "});"
                ]
              }
            }
          ]
        },
